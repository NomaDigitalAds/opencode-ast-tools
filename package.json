{
  "name": "opencode-ast-tools",
  "version": "0.1.0-alpha.1",
  "description": "Safe structural search and AST refactoring tools for OpenCode",
  "type": "module",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/NomaDigitalAds/opencode-ast-tools.git"
  },
  "bugs": {
    "url": "https://github.com/NomaDigitalAds/opencode-ast-tools/issues"
  },
  "homepage": "https://github.com/NomaDigitalAds/opencode-ast-tools#readme",
  "publishConfig": {
    "access": "public",
    "provenance": true,
    "tag": "alpha"
  },
  "files": [
    "dist",
    "README.md",
    "ROADMAP.md",
    "LICENSE",
    "THIRD_PARTY_NOTICES.md"
  ],
  "exports": {
    ".": {
      "types": "./dist/plugin.d.ts",
      "import": "./dist/plugin.js"
    },
    "./server": {
      "types": "./dist/plugin.d.ts",
      "import": "./dist/plugin.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "check": "tsc -p tsconfig.json --noEmit",
    "check:test": "tsc -p tsconfig.test.json",
    "check:package": "node scripts/check-package.mjs",
    "pack:release": "node scripts/check-package.mjs --pack",
    "test": "vitest run",
    "test:integration": "vitest run test/engine-integration.test.ts",
    "test:opencode": "npm run build && vitest run test/opencode-smoke.test.ts",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@ast-grep/cli": "0.44.1",
    "@opencode-ai/plugin": "1.18.4",
    "ignore": "7.0.6",
    "minimatch": "10.2.5"
  },
  "devDependencies": {
    "@ai-sdk/openai-compatible": "3.0.14",
    "@opencode-ai/sdk": "1.18.4",
    "@types/node": "24.0.14",
    "opencode-ai": "1.18.4",
    "typescript": "7.0.2",
    "vitest": "4.1.10"
  },
  "engines": {
    "node": "^22.22.2 || ^24.15.0 || >=26"
  },
  "keywords": [
    "opencode",
    "ast-grep",
    "codemod",
    "refactoring"
  ]
}
